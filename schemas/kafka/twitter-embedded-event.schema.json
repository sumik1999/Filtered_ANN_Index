{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://temporal-ann.local/schemas/twitter-embedded-event-v1.json",
  "title": "TwitterEmbeddedEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "index_name", "source_event_id", "tweet_id",
    "event_time_ms", "ingest_time_ms", "embedding_model",
    "embedding_dimension", "embedding", "content_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "index_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_event_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "tweet_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "event_time_ms": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
    "ingest_time_ms": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "embedding_model": { "type": "string", "minLength": 1, "maxLength": 256 },
    "embedding_dimension": { "const": 384 },
    "embedding": {
      "type": "array", "minItems": 384, "maxItems": 384,
      "items": { "type": "number" }
    },
    "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
