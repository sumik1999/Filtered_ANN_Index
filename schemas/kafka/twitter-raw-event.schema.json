{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://temporal-ann.local/schemas/twitter-raw-event-v1.json",
  "title": "TwitterRawEventV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_event_id",
    "tweet_id",
    "event_time_ms",
    "ingest_time_ms",
    "text",
    "language"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_event_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "tweet_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "event_time_ms": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
    "ingest_time_ms": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "text": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "language": { "type": "string", "minLength": 2, "maxLength": 16 },
    "source": { "type": "string", "maxLength": 128 },
    "metadata": { "type": "object" }
  }
}
